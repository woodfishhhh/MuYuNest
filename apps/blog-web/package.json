{
  "name": "@woodfish-nest/blog-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "verify:dist": "pnpm --filter @woodfish-nest/content-tools exec tsx src/cli.ts verify-dist --dist-dir apps/blog-web/dist",
    "build:deploy": "vite build && pnpm verify:dist",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@unhead/vue": "3.1.0",
    "gsap": "^3.14.2",
    "liquid-gl": "2.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "three": "^0.184.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/vue3": "^8.6.18",
    "@storybook/vue3-vite": "^8.6.18",
    "storybook": "^8.6.18",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "tailwindcss": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/nprogress": "^0.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/test-utils": "^2.4.6",
    "@playwright/test": "^1.59.1",
    "jsdom": "^29.0.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "vite": "8.0.14",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.2.6"
  }
}

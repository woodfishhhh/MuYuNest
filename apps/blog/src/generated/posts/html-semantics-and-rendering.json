D\">option</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">      &lt;</span><span style=\"--shiki-light:#22863A;--shiki-dark:#85E89D\">option</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> value</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"sz\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">&gt;深圳&lt;/</span><span style=\"--shiki-light:#22863A;--shiki-dark:#85E89D\">option</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">    &lt;/</span><span style=\"--shiki-light:#22863A;--shiki-dark:#85E89D\">select</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  &lt;/</span><span style=\"--shiki-light:#22863A;--shiki-dark:#85E89D\">div</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  &lt;</span><span style=\"--shiki-light:#22863A;--shiki-dark:#85E89D\">button</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> type</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"submit\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">&gt;提交注册&lt;/</span><span style=\"--shiki-light:#22863A;--shiki-dark:#85E89D\">button</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  &lt;</span><span style=\"--shiki-light:#22863A;--shiki-dark:#85E89D\">button</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> type</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"reset\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">&gt;重置&lt;/</span><span style=\"--shiki-light:#22863A;--shiki-dark:#85E89D\">button</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  &lt;</span><span style=\"--shiki-light:#22863A;--shiki-dark:#85E89D\">button</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> type</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"button\"</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> id</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"previewBtn\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">&gt;预览&lt;/</span><span style=\"--shiki-light:#22863A;--shiki-dark:#85E89D\">button</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">&lt;/</span><span style=\"--shiki-light:#22863A;--shiki-dark:#85E89D\">form</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"></span></code></pre>\n<p>此外，超链接 <code>&lt;a href=\"...\" target=\"_blank\"&gt;</code> 在需要新开标签页时，建议同时补充 <code>rel=\"noopener noreferrer\"</code>，防止新页面通过 <code>window.opener</code> 访问原页面上下文。音频 <code>&lt;audio&gt;</code> 与视频 <code>&lt;video&gt;</code> 若开启 <code>autoplay</code>，现代浏览器要求必须同时携带 <code>muted</code> 才会生效。</p>\n<h2 id=\"样式引入图片格式与资源加载\">样式引入、图片格式与资源加载</h2>\n<p>外部样式表的两种引入方式在浏览器解析阶段行为差异很大：</p>\n<p><strong>优先用 <code>&lt;link&gt;</code> 引入外部样式表，业务样式里避免嵌套 <code>@import</code>。</strong></p>\n<table>\n<thead>\n<tr>\n<th>引入方式</th>\n<th>声明位置</th>\n<th>资源发现与加载时机</th>\n<th>工程影响</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>&lt;link rel=\"stylesheet\" href=\"...\"&gt;</code></td>\n<td>HTML <code>&lt;head&gt;</code></td>\n<td>HTML 预加载扫描器在解析阶段就能立即发现并并行下载</td>\n<td>更早构建 CSSOM，减少首屏等待</td>\n</tr>\n<tr>\n<td><code>@import url(\"...\");</code></td>\n<td>CSS 文件内部</td>\n<td>必须等外层 CSS 下载并解析完毕后，才发起内层 CSS 请求</td>\n<td>串行拉长关键依赖链，推迟首次绘制</td>\n</tr>\n</tbody>\n</table>\n<p>页面图片格式同样需要在清晰度、透明通道与体积之间做取舍：</p>\n<table>\n<thead>\n<tr>\n<th>格式</th>\n<th>压缩方式</th>\n<th>透明通道</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>SVG</code></td>\n<td>矢量图形</td>\n<td>支持</td>\n<td>Logo、UI 图标、结构图，任意缩放不失真</td>\n</tr>\n<tr>\n<td><code>PNG</code></td>\n<td>无损压缩</td>\n<td>支持（Alpha）</td>\n<td>需要透明背景或像素级锐利的截图与素材</td>\n</tr>\n<tr>\n<td><code>JPG / JPEG</code></td>\n<td>有损压缩</td>\n<td>不支持</td>\n<td>摄影照片、色彩丰富的大图展示</td>\n</tr>\n<tr>\n<td><code>WebP / AVIF</code></td>\n<td>有损与无损均支持</td>\n<td>支持</td>\n<td>现代 Web 通用首选，同画质下体积明显小于 PNG/JPG</td>\n</tr>\n<tr>\n<td><code>GIF</code></td>\n<td>无损（256 色）</td>\n<td>1 位透明</td>\n<td>简单帧动画；长动画建议改用静音 <code>&lt;video&gt;</code></td>\n</tr>\n</tbody>\n</table>\n<h2 id=\"浏览器渲染路径回流与重绘\">浏览器渲染路径、回流与重绘</h2>\n<p>浏览器拿到 HTML 和 CSS 字节流后，必须经过完整的关键渲染路径（Critical Rendering Path）才能在屏幕上输出像素：</p>\n<ol>\n<li><strong>解析 HTML 生成 DOM 树</strong>，遇到同步 <code>&lt;script&gt;</code> 会阻塞解析（可通过 <code>defer</code> 或 <code>&lt;script type=\"module\"&gt;</code> 延迟到文档解析完再执行）。</li>\n<li><strong>解析 CSS 生成 CSSOM 树</strong>，CSS 属于渲染阻塞资源，CSSOM 未就绪前浏览器不会执行首次绘制。</li>\n<li><strong>合并 DOM 与 CSSOM 生成渲染树（Render Tree）</strong>，跳过 <code>display: none</code>、<code>head</code> 等不可见节点。</li>\n<li><strong>布局（Layout / Reflow）</strong>：计算渲染树中每个节点的精确几何尺寸与视口位置。</li>\n<li><strong>绘制（Paint）与合成（Composite）</strong>：把节点栅格化为像素图层并合成输出到屏幕。</li>\n</ol>\n<p>样式变更后的性能代价取决于它落在这条链路的哪一阶段：</p>\n<ul>\n<li><strong>重绘（Repaint）</strong>：仅改变颜色、背景色、<code>box-shadow</code> 或 <code>visibility</code> 等视觉外观，元素几何位置和尺寸不变，跳过布局阶段直接重新绘制。</li>\n<li><strong>回流（Reflow / 重排）</strong>：元素的宽高、边距、字体大小、位置或 DOM 结构发生变化，迫使浏览器重新计算部分甚至整棵文档树的几何布局，并在之后连带触发重绘。</li>\n</ul>\n<p><strong>回流一定会触发后续绘制流程，而重绘不一定引发回流；动画与高频交互必须极力避开回流。</strong></p>\n<p>工程中减少回流与重绘有四条直接抓手：</p>\n<ol>\n<li><strong>批量切换样式</strong>：避免在循环里逐行修改 <code>el.style.width</code>、<code>el.style.height</code>，通过一次切换 <code>classList</code> 完成样式变更。</li>\n<li><strong>避免强制同步布局（Layout Thrashing）</strong>：不要在刚写入样式后紧接着读取 <code>offsetTop</code>、<code>offsetWidth</code>、<code>getBoundingClientRect()</code> 等几何属性——这会迫使浏览器立刻清空渲染队列同步执行一次回流以返回最新数值。应该先批量读完所有几何值，再集中写入新样式。</li>\n<li><strong>隔离高频动画图层</strong>：位移动画用 <code>transform: translate3d(...)</code> 和 <code>opacity</code> 替代修改 <code>top</code>/<code>left</code> 或 <code>width</code>/<code>height</code>，让变化直接落在 GPU 合成层。</li>\n<li><strong>控制同时挂载的 DOM 规模</strong>：长列表结合虚拟滚动或分页按需挂载（详见 <a href=\"/posts/frontend-streaming-markdown-virtual-list\">前端工程问题复盘：SSE 流式输出、Markdown 容错与虚拟列表</a>），从源头上压低样式计算与布局树的节点基数。</li>\n</ol>\n",

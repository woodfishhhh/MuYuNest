#E1E4E8\">) </span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">Rename</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#E36209;--shiki-dark:#FFAB70\">next</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> string</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">\tu.Name </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> next</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">func</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> main</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">\tu </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">:=</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> User</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">\t\tAuditMeta: </span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">AuditMeta</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">{UpdatedBy: </span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"admin\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">},</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">\t\tName:      </span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"woodfish\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">\t\tAge:       </span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">22</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">\t}</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">\tu.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">Rename</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"muyu\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">// 编译器自动取地址 (&amp;u).Rename(...)</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">\tfmt.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">Println</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(u.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">Summary</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(), u.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">TouchInfo</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(), u.AuditMeta.UpdatedBy)</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span></code></pre>\n<p>如果外层和内嵌结构体定义了同名字段，外层字段会遮蔽内层，需要访问被遮蔽字段时写完整路径 <code>u.AuditMeta.Field</code> 即可。</p>\n<p>在生产代码中，结构体字段后面经常跟着反引号写的 <strong>Struct Tag</strong>，运行期靠反射读取。最常见的是 <code>encoding/json</code> 标签：</p>\n<pre data-language=\"go\" class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\"><code class=\"language-go\"><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">package</span><span style=\"--shiki-light
92E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">    listEl.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">addEventListener</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"click\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">.#handleMoveToPopup.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">bind</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  #</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">initGeolocation</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">() { </span><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">/* 获取定位后初始化地图并恢复历史 Marker */</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  #</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">handleCreateWorkout</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#E36209;--shiki-dark:#FFAB70\">e</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">) { </span><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">/* 校验表单 -&gt; 实例化 Running/Cycling -&gt; 渲染并落盘 */</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  #</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">handleMoveToPopup</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#E36209;--shiki-dark:#FFAB70\">e</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">) { </span><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">/* 事件委托读取 data-id -&gt; 移动地图视角 */</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  #</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">saveToStorage</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">() { localStorage.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">setItem</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"workouts\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">JSON</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">stringify</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">.#workouts)); }</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  #</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">loadFromStorage</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">() { </span><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">/* 读取并容错解析 JSON */</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> }</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span></code></pre>\n<p>如果后期项目继续膨胀需要按多页面或多成员协作拆分，直接把 storage、form validator、map adapter 拆成独立 ES Module 文件即可，类内部的私有方法边界几乎可以原封不动平移过去。</p>\n<h2 id=\"第四步开发落地顺序与反例避坑\">第四步：开发落地顺序与反例避坑</h2>\n<p>进入编码前，先把关键技术依赖（第三方库 CDN 或 npm 包、浏览器权限 API）和统一的 JSON 存储 schema 锁定，按<strong>最小闭环先行</strong>的顺序迭代：</p>\n<ol>\n<li><strong>先打通主链路 MVP</strong>：只做“地图加载 + 点击弹表单 + 提交后在列表和地图上渲染出一条记录”，先不急着做复杂的筛选、动画和主题切换。</li>\n<li><strong>再补齐持久化与边界兜底</strong>：接入 <code>localStorage</code> 恢复、Geolocation 拒绝授权时的默认兜底坐标、以及 <code>JSON.parse</code> 反序列化后原型方法丢失的处理（注意：从 <code>localStorage</code> 恢复出来的对象只是普通 JSON 字面量，不再拥有 <code>Running</code>/<code>Cycling</code> 原型上的方法，如需调用实例方法要重新实例化或写成纯函数）。</li>\n<li><strong>随开发同步修订架构图</strong>：一旦在编码中发现遗漏了“表单输入负数校验”或“清空全部记录”需求，先补全对应分支的状态流，再修改模块代码，避免临时打补丁破坏原有职责边界。</li>\n</ol>\n<h3 id=\"避坑反例为什么不要把状态全挂在全局数组里\">避坑反例：为什么不要把状态全挂在全局数组里</h3>\n<p>直接把 <code>let workouts = []</code> 和十几个全局函数平铺在顶层脚本里，初期看似少写了几十行封装代码，但很快会遇到三个问题：同名全局变量与其他脚本冲突、DOM 事件回调里直接散落修改 <code>workouts</code> 导致找不到数据是在哪一步被改坏的、想要做本地缓存同步或单元测试时无从切入。哪怕是不使用 Vue/React 的纯原生 JS 小项目，坚持用模块私有状态 + 单一应用协调器管理状态变更，也能把后续维护成本压到最低。</p>\n",

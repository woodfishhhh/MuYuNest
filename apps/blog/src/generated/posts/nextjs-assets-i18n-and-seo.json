t:#032F62;--shiki-dark:#9ECBFF\"> /</span><span style=\"--shiki-light:#22863A;--shiki-light-font-weight:bold;--shiki-dark:#85E89D;--shiki-dark-font-weight:bold\">\\.</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">[</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">^</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">/]</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">+$</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">test</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(pathname) </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> pathname.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">startsWith</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">'/_next'</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> (hasLocale </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> isAsset) </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> NextResponse.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">next</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> locale</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> negotiateLocale</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(request) </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> defaultLocale</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> NextResponse.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">redirect</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> URL</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">`/${</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">locale</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">}${</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">pathname</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">}`</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">, request.url))</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> config</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  matcher: [</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">'/((?!api|_next/static|_next/image|favicon.ico).*)'</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span></code></pre>\n<p><strong>i18n <code>proxy.ts</code> 的 <code>matcher</code> 必须跳过 <code>/api</code>、<code>_next</code> 和静态文件，否则图片、接口和客户端资源请求全会被重定向到 <code>/zh-CN/...</code> 造成全站资源 404 或重定向死循环。</strong></p>\n<h2 id=\"seo-元数据robotstssitemaptsmetadata-api-与-json-ld\">SEO 元数据：<code>robots.ts</code>、<code>sitemap.ts</code>、Metadata API 与 JSON-LD</h2>\n<p>搜索引擎的核心链路是“发现 URL -&gt; 抓取 HTML -&gt; 理解结构化语义 -&gt; 评估性能体验”。App Router 把全套技术 SEO 能力直接变成了类型化的文件约定：</p>\n<ol>\n<li><strong><code>app/robots.ts</code></strong>：声明通用抓取策略与 <code>sitemap</code> 入口。<strong>切记 <code>disallow: ['/api/', '/admin/']</code> 只是向守规矩爬虫发出的声明，绝不是访问控制，后台接口与私有页面必须靠服务端认证拦截。</strong></li>\n<li><strong><code>app/sitemap.ts</code></strong>：从数据库查询已发布文章动态输出规范 URL（单文件数量超限时配合 <code>generateSitemaps</code> 拆分）。只放入返回 200 的 Canonical 正规地址，不要把登录页、分页筛选组合塞进去浪费抓取预算。</li>\n<li><strong><code>Metadata</code> 与 <code>generateMetadata</code></strong>：在根布局配置 <code>metadataBase: new URL('https://example.com')</code> 让相对路径的 Open Graph / Twitter 卡片图自动解析为完整绝对地址；动态文章页通过异步 <code>generateMetadata({ params })</code> 查出标题、摘要、封面图与 <code>alternates.canonical</code>（与正文共用服务端数据缓存防止重复查库）。</li>\n<li><strong>JSON-LD 结构化数据</strong>：把符合 <code>schema.org</code> 规范的 <code>Article</code>、<code>BreadcrumbList</code> 序列化为 <code>&lt;script type=\"application/ld+json\"&gt;</code>，且序列化时务必对 <code>&lt;</code> 做转义防止闭合脚本标签注入：</li>\n</ol>\n<pre data-language=\"tsx\" class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\"><code class=\"language-tsx\"><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> safeJson</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> JSON</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">stringify</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(jsonLd).</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">replace</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"--shiki-light:#032F62;--shiki-dark:#DBEDFF\">&lt;</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">g</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">'</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">\\\\</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">u003c'</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  &lt;</span><span style=\"--shiki-light:#22863A;--shiki-dark:#85E89D\">script</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">    type</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"application/ld+json\"</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">    dangerouslySetInnerHTML</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">{{ __html: safeJson }}</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  /&gt;</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span></code></pre>\n<p>结构化数据中的作者、发布时间与摘要必须与页面真实可见内容完全一致，避免被搜索引擎判定为垃圾作弊。</p>\n<h2 id=\"web-vitals-真实用户指标采集\">Web Vitals 真实用户指标采集</h2>\n<p>上线后除了用 Lighthouse 跑实验室基线，还需要通过 <code>web-vitals</code> 在客户端采集真实用户分布（Core Web Vitals 关注第 75 百分位阈值：<code>LCP &lt;= 2.5s</code>、<code>INP &lt;= 200ms</code>、<code>CLS &lt;= 0.1</code>），利用不阻塞页面卸载的 <code>navigator.sendBeacon</code> 上报指标：</p>\n<pre data-language=\"tsx\" class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\"><code class=\"language-tsx\"><span class=\"line\"><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">'use client'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> { onCLS, onINP, onLCP, </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> Metric } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> 'web-vitals'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">function</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> report</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#E36209;--shiki-dark:#FFAB70\">metric</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> Metric</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> body</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> JSON</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">stringify</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">    name: metric.name,</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">    value: metric.value,</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">    id: metric.id,</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">    path: window.location.pathname,</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  })</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  navigator.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">sendBeacon</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">'/api/vitals'</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">, body)</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">onCLS</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(report)</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">onINP</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(report)</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">onLCP</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(report)</span></span>\n<span class=\"line\"></span></code></pre>\n<p>接收上报的 <code>/api/vitals</code> 端点需要做好字段校验和限频，只记录聚合所需的路径和指标数值，避免将带有敏感 Query 参数的完整 URL 或用户身份标识写入分析日志。</p>\n",

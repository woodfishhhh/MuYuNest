-dark:#F97583\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> './App.vue'</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> { router } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> './router'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">createApp</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(App)</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  .</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">use</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">createPinia</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">())</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  .</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">use</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(router)</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  .</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">mount</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">'#app'</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span></code></pre>\n<p>如果导航守卫抽离在应用挂载之前就会执行，则需显式导出 <code>pinia</code> 实例并在守卫中传入 <code>useSessionStore(pinia)</code>。</p>\n<h2 id=\"导航方式参数边界与嵌套布局\">导航方式、参数边界与嵌套布局</h2>\n<p>业务组件跳转优先引用稳定的命名路由（<code>{ name: 'user-detail', params: { id } }</code>），不要在模板里到处写死字符串路径，日后修改 URL 结构只需动路由表一处。站内跳转使用 <code>&lt;RouterLink&gt;</code> 或 <code>router.push()</code> / <code>router.replace()</code>（登录成功后用 <code>replace</code> 防止用户点浏览器后退又回到登录页）；站外链接和文件下载继续使用原生 <code>&lt;a&gt;</code>。</p>\n<h3 id=\"path-params-与-query-的职责划分\">Path Params 与 Query 的职责划分</h3>\n<ul>\n<li><strong>Path Params（<code>/products/:id</code>）</strong>：用来标识唯一资源实体。配合路由项 <code>props: true</code>，组件直接通过 <code>defineProps&lt;{ id: string }&gt;()</code> 接收参数，脱离对 <code>useRoute()</code> 的耦合更方便单元测试。注意运行时拿到的参数永远是 <code>string | string[]</code>，必须手动做数值转换和合法性校验。</li>\n<li><strong>Query（<code>?page=2&amp;sort=price</code>）</strong>：用来承载筛选、分页、排序等可分享的界面状态。<strong>切勿把完整的商品对象塞进未在路径声明的隐式 <code>params</code>（刷新即丢），也绝不能把密码、Token 或个人隐私信息放进 URL Query（会被浏览器历史、Nginx 日志和 <code>Referer</code> 泄露）。</strong></li>\n</ul>\n<h3 id=\"嵌套路由与命名视图\">嵌套路由与命名视图</h3>\n<p>后台管理常见的固定侧栏 + 动态主内容区，适合用嵌套路由 <code>children</code> 描述。<strong>嵌套子路由的 <code>path</code> 必须写成相对路径（如 <code>'users'</code> 拼出 <code>/app/users</code>），一旦误加前导斜杠 <code>'/users'</code>，它会直接变成根级路径脱离父布局。</strong></p>\n<pre data-language=\"ts\" class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\"><code class=\"language-ts\"><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> routes</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> RouteRecordRaw</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">    path: </span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">'/app'</span><span style=\"--shiki-li
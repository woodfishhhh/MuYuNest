MUYU_DB_PATH=data/muyu.db
MUYU_ANALYTICS_DB_PATH=data/analytics.db
IMAGE_ROOT=data/images
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
# Development only. Production must use the existing Python secret file.
VISITOR_ANALYTICS_SECRET=development-only-secret

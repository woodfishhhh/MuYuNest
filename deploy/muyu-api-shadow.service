[Unit]
Description=MuYu Go API parallel metrics rehearsal (no production traffic)
After=network.target

[Service]
Type=simple
DynamicUser=true
StateDirectory=muyu-api-shadow
StateDirectoryMode=0700
WorkingDirectory=/var/lib/muyu-api-shadow
LoadCredential=analytics-secret:/etc/woodfish/analytics-secret
Environment=MUYU_ADDR=127.0.0.1:3012
Environment=MUYU_DB_PATH=/var/lib/muyu-api-shadow/muyu.db
Environment=MUYU_ANALYTICS_DB_PATH=/var/lib/muyu-api-shadow/analytics.db
Environment=IMAGE_ROOT=/var/lib/muyu-api-shadow/images
Environment=VISITOR_ANALYTICS_SECRET_FILE=%d/analytics-secret
Environment=CORS_ALLOWED_ORIGINS=https://blog.woodfish.site
Environment=GIN_MODE=release
ExecStart=/opt/blog-stack/services/muyu-api-shadow/api
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target

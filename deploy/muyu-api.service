[Unit]
Description=MuYu Go API
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
DynamicUser=true
StateDirectory=muyu-api
StateDirectoryMode=0700
WorkingDirectory=/var/lib/muyu-api
LoadCredential=analytics-secret:/etc/woodfish/analytics-secret
Environment=MUYU_ADDR=172.18.0.1:3013
Environment=MUYU_DB_PATH=/var/lib/muyu-api/muyu.db
Environment=MUYU_ANALYTICS_DB_PATH=/var/lib/muyu-api/analytics.db
Environment=IMAGE_ROOT=/var/lib/muyu-api/images
Environment=VISITOR_ANALYTICS_SECRET_FILE=%d/analytics-secret
Environment=CORS_ALLOWED_ORIGINS=https://blog.woodfish.site
Environment=GIN_MODE=release
ExecStart=/opt/blog-stack/services/muyu-api/api
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
